// An actor owns its variables and its actions.
// init() runs before main(), and the variables keep their values
// from one action to the next.
actor Lamp
{
    int mBrightness;

    action init()
    {
        mBrightness = 0;
        print("Lamp: Installed.\n");
    }

    action brighten()
    {
        mBrightness = mBrightness + 50;
        print("Lamp: Brightness %d.\n", mBrightness);
    }
}

// Another actor asks Lamp to run its action and waits for it.
actor Player
{
    action main()
    {
        awaitCompletion(1, Lamp->brighten());
        awaitCompletion(1, Lamp->brighten());
        print("Player: That's bright enough.\n");
    }
}
