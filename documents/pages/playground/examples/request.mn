// request(priority, Actor->action()) asks an actor to run one of its actions.
//
// - awaitCompletion() sends the request and waits until the action ends.
// - request() only sends it; the sender goes on without waiting.
// - A request with a higher priority interrupts the action that is
//   running. The interrupted action resumes once it is done.

const int kTalk = 10;
const int kAlarm = 100;

actor Event
{
    action main()
    {
        print("Event: A traveler reaches the gate.\n");
        awaitCompletion(kTalk, Guard->talk());
        awaitCompletion(kTalk, Gate->open());
        request(kTalk, Traveler->enter());
        print("Event: Finished.\n");
    }
}

actor Guard
{
    action talk()
    {
        print("Guard: Halt! Who goes there?\n");
        request(kAlarm, self->alarm());
        print("Guard: False alarm. You may pass.\n");
    }

    action alarm()
    {
        print("Guard: (The bell rings!)\n");
    }
}

actor Gate
{
    action open()
    {
        print("Gate: *creak* The gate opens.\n");
    }
}

actor Traveler
{
    action enter()
    {
        print("Traveler: Thank you!\n");
    }
}
