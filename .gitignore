# Mana
*.mx
/examples/**/*.h
/examples/**/*.md
!/examples/**/README.md
/tests/**/*.h
/tests/**/*.md

# Generated documentation (Wiki pages and website) and Python cache.
# The manuscripts under documents/ are the source of truth; build output
# is published by the workflows and never committed.
/build/
/build-*/
/out/
_site/
__pycache__/

