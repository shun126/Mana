////////////////////////////////////////////////////////////////////////////////
// 0除算はプロセスを落とさず、アクターだけを停止します。
actor TestDivideByZeroRoot
{
    action init
    {
    }

    action main
    {
        int numerator = 10;
        int denominator = 0;
        print("before %d\n", numerator);
        print("result %d\n", numerator / denominator);
        print("unreachable\n");
    }
}
