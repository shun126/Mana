module SharedActions
{
    action inherited
    {
    }
}

actor ExtendedActor
{
    int mValue;

    action own
    {
        mValue = 1;
    }

    extend SharedActions;
}

int mValue;

actor FollowingActor
{
    action own
    {
        mValue = 2;
    }
}
