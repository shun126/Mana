const int kOpenPriority = 100;

actor Door
{
    bool mOpened;
    int mOpenCount;

    action init
    {
        mOpened = false;
        mOpenCount = 0;

        request(kOpenPriority, self->open);
        yield();

        print("door opened: %d count: %d\n", mOpened, mOpenCount);
    }

    action open
    {
        if (mOpened)
            return;

        mOpened = true;
        mOpenCount += 1;
    }
}
