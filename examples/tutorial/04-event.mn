actor Event
{
    action main()
    {
        await(10, Guide->talk());
        await(10, Gate->open());
        print("Event: Finished.\n");
    }
}

actor Guide
{
    action talk()
    {
        print("Guide: Welcome!\n");
    }
}

actor Gate
{
    action open()
    {
        print("Gate: Open.\n");
    }
}
