actor Event
{
    action main()
    {
        bool hasKey = true;

        await(10, Guide->talk());
        if (hasKey)
        {
            await(10, Gate->open());
        }
        else
        {
            print("Event: Find the key.\n");
        }
    }
}

actor Guide
{
    action talk()
    {
        print("Guide: Welcome!\n");
    }
}

actor Gate
{
    action open()
    {
        print("Gate: Open.\n");
    }
}
