actor Event
{
    action main()
    {
        await(10, Guide->talk());
        await(10, Guide->talk());
    }
}

actor Guide
{
    int mTalkCount;

    action init()
    {
        mTalkCount = 0;
    }

    action talk()
    {
        mTalkCount = mTalkCount + 1;
        print("Talk count: %d\n", mTalkCount);
    }
}
